NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
LEAD_CAPTURE_SALT=replace-with-random-server-secret

# Optional public acquisition configuration
BOOKING_URL=
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Optional WhatsApp Cloud API configuration
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=replace-with-server-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-business-account-id
WHATSAPP_VERIFY_TOKEN=replace-with-random-verification-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_SIMULATOR_ENABLED=false

# Keep production secrets outside Git and configure them in the deployment platform.
